rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isKiosk() {
      return role() == 'kiosk';
    }

    function validTicket(ticket) {
      return ticket is int && ticket >= 1 && ticket <= 10;
    }

    function ticketMatchesSlot(slotId, ticket) {
      return (slotId == '1' && ticket == 1)
        || (slotId == '2' && ticket == 2)
        || (slotId == '3' && ticket == 3)
        || (slotId == '4' && ticket == 4)
        || (slotId == '5' && ticket == 5)
        || (slotId == '6' && ticket == 6)
        || (slotId == '7' && ticket == 7)
        || (slotId == '8' && ticket == 8)
        || (slotId == '9' && ticket == 9)
        || (slotId == '10' && ticket == 10);
    }

    function validTotals(data) {
      return data.totalCups is int
        && data.totalCups >= 1
        && data.totalCups <= 20
        && data.totalPieces == data.totalCups * 4
        && data.totalAmount == data.totalCups * 300;
    }

    function validPayment(data) {
      return data.paymentMethod in ['cash', 'paypay'];
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /config/store {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.activeMenuDay in ['day11', 'day12'];
      allow delete: if false;
    }

    match /slots/{slotId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && validTicket(request.resource.data.ticketNumber)
        && request.resource.data.state == 'available';
      allow update: if isAdmin() || (
        isKiosk()
        && resource.data.state == 'available'
        && request.resource.data.state == 'received'
        && validTicket(request.resource.data.ticketNumber)
        && ticketMatchesSlot(slotId, request.resource.data.ticketNumber)
        && request.resource.data.orderId is string
        && request.resource.data.checkoutId == request.resource.data.orderId
        && request.resource.data.menuDay in ['day11', 'day12']
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 7
        && validTotals(request.resource.data)
        && validPayment(request.resource.data)
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.ticketNumber
          == request.resource.data.ticketNumber
        && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.checkoutId)).data.ticketNumber
          == request.resource.data.ticketNumber
      );
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isKiosk()
        && request.resource.data.status == 'received'
        && request.resource.data.checkoutId == orderId
        && validTicket(request.resource.data.ticketNumber)
        && request.resource.data.menuDay in ['day11', 'day12']
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 7
        && validTotals(request.resource.data)
        && validPayment(request.resource.data)
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.ticketNumber)).data.orderId
          == orderId
        && getAfter(/databases/$(database)/documents/sales/$(orderId)).data.orderId
          == orderId;
      allow update: if isAdmin()
        && request.resource.data.ticketNumber == resource.data.ticketNumber
        && request.resource.data.checkoutId == resource.data.checkoutId
        && request.resource.data.menuDay == resource.data.menuDay
        && request.resource.data.items == resource.data.items
        && request.resource.data.totalCups == resource.data.totalCups
        && request.resource.data.totalPieces == resource.data.totalPieces
        && request.resource.data.totalAmount == resource.data.totalAmount
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.status in ['cooking', 'ready', 'completed', 'cancelled'];
      allow delete: if isAdmin()
        && resource.data.status in ['completed', 'cancelled'];
    }

    match /sales/{saleId} {
      allow read: if isAdmin();
      allow create: if isKiosk()
        && request.resource.data.checkoutId == saleId
        && request.resource.data.orderId == saleId
        && request.resource.data.status == 'recorded'
        && validTicket(request.resource.data.ticketNumber)
        && request.resource.data.menuDay in ['day11', 'day12']
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 8
        && validTotals(request.resource.data)
        && validPayment(request.resource.data)
        && getAfter(/databases/$(database)/documents/orders/$(saleId)).data.checkoutId
          == saleId
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.ticketNumber)).data.checkoutId
          == saleId;
      allow update: if isAdmin()
        && resource.data.status == 'recorded'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelledAt']);
      allow delete: if false;
    }
  }
}
